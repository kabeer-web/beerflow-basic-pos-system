function flavours() {
  return ["Tikka", "Fajita", "Tandoori", "Malai Boti", "Afghani Boti", "Creamy Mayo Pizza (Special)"].map(
    (name) => ({ id: uid(), name, pricePaisa: 0 }),
  );
}

